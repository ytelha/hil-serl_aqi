+    a_means = [s["a_hat_mean"] for s in segments
+               if s.get("a_hat_mean") is not None]
+    out.update(
+        takeover_dur=float(np.mean(durs)) / CONTROL_HZ,
+        over_assist=float(np.mean([max(0, d - 20) for d in durs]))
