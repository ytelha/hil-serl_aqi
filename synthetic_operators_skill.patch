+        self.fixed_x0 = fixed_x0
+        self.reset()
+
+    # ------------------------------------------------------------------
+    def _obs(self):
+        s = np.array([self.x, self.z, self.vx, self.vz,
+                      self.f_lat, self.f_z,
+                      self.jams / JAM_BUDGET, self.t / self.max_steps])
