+class ToyInsertionEnv(gym.Env):
+    """See module docstring. Action: desired (vx, vz) in mm/s."""
+
+    metadata = {"render_modes": []}
+
+    def __init__(self, budget_s: float = BUDGET_S, seed: int = 0,
+                 fixed_x0=None):
