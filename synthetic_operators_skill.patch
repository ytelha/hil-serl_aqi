+
+    def _info(self, jam_event=False):
+        return dict(x=self.x, z=self.z, f_lat=self.f_lat, f_z=self.f_z,
+                    contact=self.contact, jammed=self.jammed,
+                    jam_event=jam_event, jams=self.jams,
+                    succeeded=self.succeeded, t=self.t * DT)
