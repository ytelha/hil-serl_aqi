<!--
  Peg-in-Hole model for policy training with LeRobot
-->
<mujoco model="peg_in_hole">

<!-- PEG dimensions:
Length (x): 0.06516308 m (65.16 mm)
Depth (y): 0.06673656 m (66.74 mm)
Height (z): 0.20000000 m (200.00 mm)
-->
  <compiler angle="degree" inertiafromgeom="true"/>

  <option timestep="0.002" integrator="implicit" cone="elliptic"
          gravity="0 0 -9.81"
          o_solimp="0.95 0.99 0.001 0.5 2" o_solref="0.002 1" o_margin="0.00">
    <flag override="enable"/>
  </option>

  <default>
    <joint armature="0" damping="0" limited="false" stiffness="0" frictionloss="0"/>
    <geom conaffinity="1" condim="3" contype="1" margin="0.001"
          friction="0.05 0.01 0.01"
          solimp=".8 .8 .01" solref=".02 1"/>
    <!-- Actuator control limits removed so the impedance controller can apply
         the force/torque required to follow the MPC delta freely (no ±1
         saturation that would compromise trajectory tracking). -->
    <motor ctrllimited="false"/>
  </default>

  <visual>
    <map znear="0.02"/> <!-- GENERATED: znear adopted from hopper to avoid near-plane clipping -->
    <quality offsamples="30" numslices="220"/>
    <global azimuth="139.209" elevation="-37.4209"/>
    <!-- Headlight: a light rigidly attached to whatever camera is rendering,
         pointing along its view direction. Because it travels with the camera
         it guarantees the surfaces the camera sees are always lit head-on --
         including the peg-following peg_side_cam panel, which otherwise never
         changed illumination as the peg moved. This is per-render (follows
         each camera), so the main view, hole view and peg view are all lit
         consistently from their own viewpoint. Raise diffuse toward 1 1 1 for
         a brighter look; ambient lifts the shadowed/back faces. -->
    <headlight ambient="0.4 0.4 0.4" diffuse="0.8 0.8 0.4"
               specular="0.2 0.2 0.2" active="1"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" width="10" height="10"
             rgb1="0.953 0.953 0.941" rgb2="0.953 0.953 0.941"/>
    <texture name="grid" type="2d" builtin="checker"
             width="512" height="512" rgb1="1 1 1" rgb2="1 1 1"/>
    <material name="grid" texture="grid" texrepeat="1 1"
              texuniform="true" reflectance=".2"/>
    <texture builtin="checker" height="100" name="texplane"
             rgb1="0 0 0" rgb2="0.8 0.8 0.8" type="2d" width="100"/>
    <material name="MatPlane" reflectance="0.5" shininess="1"
              specular="1" texrepeat="60 60" texture="texplane"/>
          <mesh name="mesh_framing1" file="meshes/framing1.obj"/>
          <mesh name="mesh_framing2" file="meshes/framing2.obj"/>
          <mesh name="mesh_framing3" file="meshes/framing3.obj"/>
          <mesh name="mesh_framing4" file="meshes/framing4.obj"/>
          <mesh name="mesh_framing5" file="meshes/framing5.obj"/>
          <mesh name="mesh_framing6" file="meshes/framing6.obj"/>
    <!-- ⚑ CONTACT FIX: peg was an exact press-fit (0.00mm clearance) with the
         hole, making insertion physically impossible (jammed at ~z=99mm with 20
         flush horizontal contacts regardless of force/friction). Shrinking the
         peg cross-section by 0.2% gives ~0.08mm per-side clearance (0.16mm total),
         so an aligned peg inserts cleanly while a >2mm misaligned peg is still
         caught at the rim. See generate_camera_mount.py-adjacent experiments. -->
    <mesh name="mesh_peg1"     file="meshes/peg1.obj" scale="0.9980 0.9980 1"/>
    <!-- Wrist-camera mount box, generated by generate_camera_mount.py.
         ⚑ FLAG 1 OPTION A: the .obj vertices are centred at the local origin
         (no translation baked in); placement is done by the body pos below. -->
    <mesh name="camera_mount_mesh" file="meshes/camera_mount.obj" scale="1 1 1"/>
  </asset>

  <worldbody>
    <site name="world"/>
    <light pos="0.1 0 0.1" dir="0 0.2 -1"
           diffuse="0.7 0.7 0.7" specular="0.3 0.3 0.3"
           directional="true"/>
    
    <body name="framing" pos="0.0 0.0 0.0" quat="1 0 0 0">
      <!-- ⚑ CLEARANCE TUNE (Jul 2026): the framing walls are per-wall meshes
           collided as CONVEX HULLS (geom type=7), whose inner hull edges bulged
           across the aperture and overlapped the peg cross-section, so the peg
           could NOT enter even when perfectly centred (it rested on the wall
           tops at z=0.20 for every offset/yaw). Shrinking the peg did not help
           (the hulls intrude from several sides). This is the next 50% reduction
           of the remaining hole margin, moving each wall halfway back toward the
           original zero-clearance framing positions.
           Peg mesh keeps its 0.998 cross-section scale. Original positions are
           preserved in src/peg_in_hole_env/assets/peg_in_hole.xml. -->
      <geom name="framing1" type="mesh" pos="0.042064133923784761 0.023200962455207898 0.0" quat="1 0 0 0" rgba=".5 .5 .5 1" mesh="mesh_framing1" />
      <geom name="framing2" type="mesh" pos="-0.038937349278368241 0.012553065099527135 1.3877787807814457e-17" quat="1 0 0 0" rgba=".5 .5 .5 1" mesh="mesh_framing2" />
      <geom name="framing3" type="mesh" pos="0.047212387043486237 -0.033504775886677246 -1.3877787807814457e-17" quat="1 0 0 0" rgba=".5 .5 .5 1" mesh="mesh_framing3" />
      <geom name="framing4" type="mesh" pos="-0.008573179051633481 0.040974977910244903 1.3877787807814457e-17" quat="1 0 0 0" rgba=".5 .5 .5 1" mesh="mesh_framing4" />
      <geom name="framing5" type="mesh" pos="-0.034547431155904439 -0.037259578261780085 1.3877787807814457e-17" quat="1 0 0 0" rgba=".5 .5 .5 1" mesh="mesh_framing5" />
      <geom name="framing6" type="mesh" pos="0.011485394101570196 -0.049214425828182563 1.3877787807814457e-17" quat="1 0 0 0" rgba=".5 .5 .5 1" mesh="mesh_framing6" />
    </body>

    <!-- Ground plane / hole bottom. Placed at z=-0.1 (the BOTTOM of the framing
         hole, which spans world z in [-0.1, 0.1]) so the hole sits fully on the
         ground instead of being half-buried. A previous version left the plane
         at z=0 -- the vertical MIDDLE of the hole -- which sealed the lower half
         and made full insertion impossible (peg jammed at centre z=0.10, bottom
         resting on the mid-hole plane). With the plane now at the true hole
         bottom it collides normally with the peg (class 1/1), so an aligned peg
         inserts all the way and SEATS on the bottom (centre z~=0) instead of
         either jamming halfway or falling through. -->
    <geom contype="1" conaffinity="1" condim="3" name="floor" pos="0 0 -0.1"
          rgba="0.8 0.9 0.8 1" size="20 20 .125"
          type="plane" material="MatPlane"/>

        <!-- Fixed hole-view camera used by Python viewer paths as a workaround for
         the MuJoCo 2.3.3 Python binding bug that aliases MjvCamera.lookat.
         Pose solves the intended free-camera framing exactly:
         lookat=(0,0,0.2), distance=sqrt(3)*0.35, azimuth=45 deg,
         elevation=-35 deg. xyaxes uses x=screen-right, y=screen-up. -->
        <camera name="hole_view_cam" mode="fixed"
        pos="-0.35113829 -0.35113829 0.54771224"
        xyaxes="0.70710678 -0.70710678 0 0.40557979 0.40557979 0.81915204"
        fovy="45"/>

    <camera name="track" mode="trackcom" pos="0.0 -0.40 0.60" xyaxes="1 0 0 0 0.707 0.707"/>

    <site name="target" pos="0.0 0.0 0.0" size="0.005" rgba="0 1 0 0.5" type="sphere"/>

    <body name="peg_cp_1"
          pos="0.007164302499763497 -0.007504666403307578 1.3241663622385792e-17"
          quat="0.9725464650246125 0.0 0.0 0.23270877372400484">
      <joint name="joint_1" type="free"
             stiffness="0" armature="0" damping="0" frictionloss="0"/>
      <geom name="peg_cp_1_0" type="mesh"
            pos="-8.998403997577276e-05 0.00018336332116445058 6.361241854286637e-19"
            quat="0.9725464650246126 0.0 0.0 -0.23270877372400486"
            rgba="0.94 0.00 0.22 1.0" mesh="mesh_peg1"/>
      <site name="peg_cp_1_site" pos="0 0 0" size="0.001" rgba="1 0 0 1"/>

      <!-- Side "insertion" camera, rigidly attached to the peg body (no joint),
           so it inherits the peg's FULL 6-DOF pose and rotates with the peg.
           Tilted DOWN to aim at the peg's bottom tip (~local (0,0,-0.1)) so the
           insertion point stays in view as the peg descends into the hole.
           Used by the teleop viewer's "Peg insertion" panel. Its viewpoint sits
           at the CENTRE of the camera_mount box below (same peg-frame pos), so
           the box mesh visually stands in for this camera; the box is inside
           the near-clip distance, so it does not occlude the view.
           xyaxes derived from cam pos (0.043809,0,0.135) looking at (0,0,-0.1):
           x=(0,1,0), y=(-0.98306,0,0.18326). -->
      <camera name="peg_side_cam" mode="fixed"
              pos="0.043809 0.000000 0.135000"
              xyaxes="0 1 0 -0.98306 0 0.18326"
              fovy="45"/>

      <!-- ⚑ FLAG 1 OPTION A applied: camera_mount.obj vertices are centred at
           the origin; this body pos (from generate_camera_mount.py, Step 1)
           shifts the box to the correct peg-edge location. The mount is half
           over the top-face edge and flush on the top face.
           ⚑ FLAG 4: the peg is inserted along its local -Z; the camera below
           looks down its own -Z (xyaxes = identity) to see down the insertion
           axis toward the hole. No <joint> here => rigid weld to the peg body,
           so the camera inherits the peg's full 6-DOF pose.
           Manually nudged from the generated (0.033809, 0, 0.115): +1 cm along
           +x (planar, away from the peg along the top edge) and +2 cm in z. -->
      <body name="camera_mount" pos="0.043809 0.000000 0.135000">
        <!-- Visual-only camera stand-in: excluded from ALL physics.
             * contype/conaffinity=0  -> never generates contacts.
             * mass="0"               -> adds NO mass or inertia to the peg. The
               model sets inertiafromgeom="true" globally, which IGNORES any
               explicit <inertial> element and derives mass from geoms; so the
               mass must be zeroed HERE, on the geom, not via <inertial>.
               Without this the box (~4.3 g at a 4 cm offset) shifts the peg's
               composite COM off the force-application site, injecting a
               parasitic torque that de-centres the peg and fights insertion. -->
        <geom name="camera_mount_geom" type="mesh" mesh="camera_mount_mesh"
              rgba="0.2 0.2 0.2 1" contype="0" conaffinity="0" mass="0"/>
        <camera name="wrist_cam" mode="fixed"
                pos="0 0 0.020000"
                xyaxes="1 0 0 0 1 0"
                fovy="60"/>
      </body>
    </body>

  </worldbody>

  <!-- ======================================================
       CONTACT: Hard contact pairs between peg and framing
  ====================================================== -->
  <contact>
    <!-- Peg-to-framing hard contacts -->
    <pair geom1="peg_cp_1_0" geom2="framing1" solimp="0.95 0.99 0.001" solref="0.001 1"/>
    <pair geom1="peg_cp_1_0" geom2="framing2" solimp="0.95 0.99 0.001" solref="0.001 1"/>
    <pair geom1="peg_cp_1_0" geom2="framing3" solimp="0.95 0.99 0.001" solref="0.001 1"/>
    <pair geom1="peg_cp_1_0" geom2="framing4" solimp="0.95 0.99 0.001" solref="0.001 1"/>
    <pair geom1="peg_cp_1_0" geom2="framing5" solimp="0.95 0.99 0.001" solref="0.001 1"/>
    <pair geom1="peg_cp_1_0" geom2="framing6" solimp="0.95 0.99 0.001" solref="0.001 1"/>
  </contact>

  <actuator>
    <!-- === TRANSLATION (World Frame) === -->
    <general name="force_x" gear="1 0 0 0 0 0" site="peg_cp_1_site" refsite="world"/>
    <general name="force_y" gear="0 1 0 0 0 0" site="peg_cp_1_site" refsite="world"/>
    <general name="force_z" gear="0 0 1 0 0 0" site="peg_cp_1_site" refsite="world"
             biastype="affine" biasprm="6.36 0 0"/>
    <general name="torque_x" gear="0 0 0 1 0 0" site="peg_cp_1_site"/>
    <general name="torque_y" gear="0 0 0 0 1 0" site="peg_cp_1_site"/>
    <general name="torque_z" gear="0 0 0 0 0 1" site="peg_cp_1_site"/>
  </actuator>

  <statistic center="0.0536291 -0.0493613 0.216334" extent="0.3"/>

</mujoco>