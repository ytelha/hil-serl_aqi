{
  // ------------------------------------------------------------------------
  // Click-to-run launcher for the MuJoCo `sim_peg_insertion` task.
  //
  // Terminal > Run Task...  (or Ctrl/Cmd+Shift+P -> "Tasks: Run Task").
  // Only the options relevant to each mode are prompted.
  //
  //   sim:     Record demos (SpaceMouse or Synthetic) / Evaluate checkpoint
  //   learner: Baseline | Active | Quality | AQI  x  Human | Synthetic demos
  //   actor:   Baseline | Active | Quality | AQI  x  Human (SpaceMouse) | Synthetic
  //
  // Workflow: run a learner task first (it prints "LEARNER READY"), then run
  // the matching actor task — each opens in its own dedicated terminal.
  // All tasks call examples/experiments/sim_peg_insertion/run.sh via SIM_* vars.
  // ------------------------------------------------------------------------
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Record demos (SpaceMouse)",
      "detail": "Collect demos with the SpaceMouse. Filtered = keep only successes.",
      "type": "shell",
      "command": "bash \"${workspaceFolder}/examples/experiments/sim_peg_insertion/run.sh\"",
      "options": {
        "env": {
          "SIM_ACTION": "record",
          "SIM_TASK": "${input:pegShape}",
          "SIM_SUCCESSES": "${input:successesNeeded}",
          "SIM_RECORD_FILTERED": "${input:demoFiltered}",
          "SIM_RENDER": "1"
        }
      },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "learner: Baseline — Human",
      "detail": "HIL-SERL baseline learner (no active gate, no quality). Uses HUMAN-collected demos. Pair with 'actor: Baseline — Human'.",
      "type": "shell",
      "command": "bash \"${workspaceFolder}/examples/experiments/sim_peg_insertion/run.sh\"",
      "options": {
        "env": {
          "SIM_ACTION": "learner",
          "SIM_MODE": "logged",
          "SIM_TASK": "${input:pegShape}",
          "SIM_OPERATOR": "${input:operatorId}",
          "SIM_ENSEMBLE_SIZE": "${input:ensembleSize}",
          "SIM_DEMO_PATH": "${input:demoPath}",
          "SIM_RESUME": "scratch",
          "SIM_SEED": "${input:seed}",
          "SIM_DEBUG": "${input:wandb}",
          "SIM_JAX_PLATFORM": "${input:jaxPlatform}"
        }
      },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true, "group": "training" }
    },
    {
      "label": "learner: Active — Human",
